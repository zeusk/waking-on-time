{
  "name": "lsr-fence-talk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "EXPORT=1 next build",
    "present": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "mac": "zsh scripts/build-mac.sh",
    "html": "node scripts/build-html.mjs",
    "dist": "npm run mac && SKIP_EXPORT=1 npm run html && SKIP_HTML=1 npm run pdf",
    "pdf": "node scripts/build-pdf.mjs"
  },
  "dependencies": {
    "cdt2d": "^1.0.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
